<UserControl
    x:Class="Pixeller.Controls.Image.PropertiesPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Pixeller.UI"
    xmlns:vm="clr-namespace:Pixeller.ViewModels"
    Width="150"
    Height="250"
    d:DesignHeight="250"
    d:DesignWidth="150"
    x:DataType="vm:ImagePropertiesUCVM"
    Background="{DynamicResource SecondaryBackgroundColor}"
    mc:Ignorable="d"
    x:Name="Root">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="NumericUpDown.NumberBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="Minimum" Value="1" />
            <Setter Property="Maximum" Value="9999" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Width" Value="55" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Width" Value="120" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,0,8,0" />
        </Style>
    </UserControl.Styles>

    <StackPanel
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Spacing="6">
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Text="{DynamicResource DpiXY}" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <ui:NumberBox Classes="NumberBox" Value="{Binding DpiX, Mode=TwoWay}" />
                <ui:NumberBox Classes="NumberBox" Value="{Binding DpiY, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Text="{DynamicResource ColorMode}" />
            <ComboBox
                ItemsSource="{Binding ColorModeNames}"
                SelectedItem="{Binding ColorModeName, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel>
            <Grid Width="120">
                <TextBlock Text="{DynamicResource BitDepth}" HorizontalAlignment="Center" />
                <Button
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Right"
                    Classes="ProportionBtn"
                    Command="{Binding ConfigureCommand}"
                    IsVisible="{Binding ConfigureVisible, ElementName=Root}"
                    IsEnabled="{Binding ConfigureEnabled, ElementName=Root}">
                    <Image
                        Width="14"
                        Height="14"
                        Source="{DynamicResource GearIcon}" />
                </Button>
            </Grid>
            <ComboBox
                IsEnabled="{Binding BitDepthEnabled}"
                ItemsSource="{Binding BitDepthNames}"
                SelectedItem="{Binding BitDepthName, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Text="{DynamicResource ColorSpaces}" />
            <ComboBox
                IsEnabled="{Binding ColorSpaceEnabled}"
                ItemsSource="{Binding ColorSpaceNames}"
                SelectedItem="{Binding ColorSpaceName, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" Text="{DynamicResource AlphaFormat}" />
            <ComboBox
                IsEnabled="{Binding AlphaFormatEnabled}"
                ItemsSource="{Binding AlphaFormatNames}"
                SelectedItem="{Binding AlphaFormatName, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
