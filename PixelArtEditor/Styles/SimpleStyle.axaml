<Styles xmlns="https://github.com/avaloniaui" xmlns:ui="clr-namespace:PixelArtEditor.UI">

    <!-- ================= Button base ================= -->
    <Style Selector="Button">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ================= Button variants ================= -->
    <Style Selector="Button.CreateButton">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="FontSize" Value="22.5" />
        <Setter Property="FontWeight" Value="DemiBold" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverColor}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryPressColor}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
    </Style>

    <Style Selector="Button.BorderButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="FontSize" Value="22.5" />
        <Setter Property="FontWeight" Value="DemiBold" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundPressColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
        </Style>
    </Style>

    <Style Selector="Button.GrayButton">
        <Setter Property="Background" Value="{DynamicResource GrayColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="FontSize" Value="22.5" />
        <Setter Property="FontWeight" Value="DemiBold" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GrayHoverColor}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GrayPressColor}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GrayColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
    </Style>

    <Style Selector="Button.WindowBaseButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiColor}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiHoverColor}" />
        </Style>
    </Style>

    <Style Selector="Button.WindowCloseButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#f44336" />
        </Style>
        <Style Selector="^ Image">
            <Setter Property="Source" Value="{DynamicResource CloseIcon}" />
        </Style>
        <Style Selector="^:pointerover Image">
            <Setter Property="Source" Value="{DynamicResource CloseIconHover}" />
        </Style>
    </Style>

    <Style Selector="Button.ActionButton">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundPressColor}" />
        </Style>
    </Style>

    <Style Selector="Button.ActionButton Image">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- ================= NumericUpDown ================= -->
    <Style Selector="NumericUpDown">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2.5" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />

        <Style Selector="^ /template/ TextBox#PART_TextBox">
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
        </Style>

        <Style Selector="^ /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="CornerRadius" Value="2.5" />
        </Style>

        <Style Selector="^:pointerover /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:pointerover /template/ TextBox#PART_TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>

        <Style Selector="^:focus-within /template/ TextBox#PART_TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:focus-within /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>

        <Style Selector="^:focus-within:pointerover /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="^:focus-within:pointerover /template/ ButtonSpinner#PART_Spinner /template/ Border#border">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
    </Style>

    <!-- ================= TextBox ================= -->
    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="MaxWidth" Value="125" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryColor}" />

        <Style Selector="^ /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2.5" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BackgroundPressColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
    </Style>

    <!-- ================= ComboBox ================= -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2.5" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:dropdownopen">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="^:dropdownopen /template/ ToggleButton#toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style> 
        <Style Selector="^ /template/ Popup#PART_Popup Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
        </Style>
    </Style>

    <!-- ================= DropDownButton ================= -->
    <Style Selector="DropDownButton">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="BorderThickness" Value="1" />

        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="^:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundPressColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="^:disabled /template/ Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundPressColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForegroundColor}" />
        </Style>
    </Style>

    <!-- ================= CheckBox ================= -->
    <Style Selector="CheckBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2.5" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="^:checked /template/ Path#checkMark">
            <Setter Property="Fill" Value="{DynamicResource ForegroundColor}" />
        </Style>
    </Style>

    <!-- ================= TextBlock ================= -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    </Style>

    <Style Selector="TextBlock.Heading">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.LayerItemText">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="ListBoxItem.Heading">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================= InstantToggleButton ================= -->
    <Style Selector="ui|InstantToggleButton.ToolButton">
        <Setter Property="Background" Value="{DynamicResource UiColor}" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiHoverColor}" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="^:pointerover:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverColor}" />
        </Style>
    </Style>

    <Style Selector="ui|InstantToggleButton.ProportionButton">
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
        <Style Selector="^:pointerover:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
    </Style>

    <Style Selector="ui|InstantToggleButton.LayerItemButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="CornerRadius" Value="2.5" />
    </Style>

    <!-- ================= ListBox ================= -->
    <Style Selector="ListBox">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox ListBoxItem Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox ListBoxItem">
        <Style Selector="^:pointerover ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        </Style>
        <Style Selector="^:selected ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
        </Style>
    </Style>

    <Style Selector="StackPanel.LayerItem">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ================= ScrollBar ================= -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar[IsExpanded=True]">
        <Style Selector="^ /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ScrollBackgroundColor}" />
        </Style>

        <Style Selector="^ /template/ RepeatButton#PART_PageUpButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^ /template/ RepeatButton#PART_PageDownButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^ Path">
                <Setter Property="Fill" Value="{DynamicResource GrayColor}" />
            </Style>
            <Style Selector="^:pointerover Path">
                <Setter Property="Fill" Value="{DynamicResource GrayHoverColor}" />
            </Style>
            <Style Selector="^:pressed Path">
                <Setter Property="Fill" Value="{DynamicResource PrimaryColor}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^ Path">
                <Setter Property="Fill" Value="{DynamicResource GrayColor}" />
            </Style>
            <Style Selector="^:pointerover Path">
                <Setter Property="Fill" Value="{DynamicResource GrayHoverColor}" />
            </Style>
            <Style Selector="^:pressed Path">
                <Setter Property="Fill" Value="{DynamicResource PrimaryColor}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ Thumb Border">
            <Setter Property="Background" Value="{DynamicResource GrayColor}" />
        </Style>
        <Style Selector="^ /template/ Thumb:pointerover Border">
            <Setter Property="Background" Value="{DynamicResource GrayHoverColor}" />
        </Style>
        <Style Selector="^ /template/ Thumb:pressed Border">
            <Setter Property="Background" Value="{DynamicResource GrayHoverColor}" />
        </Style>

        <Style Selector="^ /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="{DynamicResource ScrollBackgroundColor}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Style>

    <!-- ================= Top menu (Button + Flyout) ================= -->
    <Style Selector="Button.MenuButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiColor}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiColor}" />
        </Style>
        <Style Selector="^.MenuOpen /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiColor}" />
        </Style>
    </Style>

    <Style Selector="Button.MenuEntry">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiColor}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UiPressColor}" />
        </Style>
    </Style>

    <Style Selector="Separator.MenuSeparator">
        <Setter Property="Background" Value="{DynamicResource GrayColor}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style Selector="Border.MenuBorder">
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GrayColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- ================= Editor / Layer panel misc ================= -->
    <Style Selector="Border.EditorBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource BackgroundPressColor}" />
    </Style>

    <!-- ================= ColorView / ColorPicker (Fluent chrome, not yet fixed on Simple) ================= -->
    <Style Selector="ColorView RadioButton">
        <Setter Property="Background" Value="{DynamicResource UiColor}" />
        <Setter Property="CornerRadius" Value="2.5" />
    </Style>

    <Style Selector="ColorView RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiHoverColor}" />
    </Style>

    <Style Selector="ColorView RadioButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiPressColor}" />
    </Style>

    <Style Selector="ColorView RadioButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="ColorView TabItem">
        <Setter Property="Background" Value="{DynamicResource UiColor}" />
    </Style>

    <Style Selector="ColorView TabItem:pointerover /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ColorView TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ColorView TabItem:pressed /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ColorView TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiHoverColor}" />
    </Style>

    <Style Selector="ColorView TabItem:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource UiPressColor}" />
    </Style>

    <Style Selector="ColorView TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="ColorView TabItem:pointerover:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverColor}" />
    </Style>

    <Style Selector="ColorView TabItem:focus-within:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressColor}" />
    </Style>

    <Style Selector="ColorPicker">
        <Setter Property="CornerRadius" Value="2.5" />
    </Style>

    <Style Selector="ColorPicker:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    </Style>

    <Style Selector="ColorPicker RadioButton">
        <Setter Property="Background" Value="{DynamicResource UiColor}" />
        <Setter Property="CornerRadius" Value="2.5" />
    </Style>

    <Style Selector="ColorPicker RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiHoverColor}" />
    </Style>

    <Style Selector="ColorPicker RadioButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiPressColor}" />
    </Style>

    <Style Selector="ColorPicker RadioButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="ColorPicker DropDownButton">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    </Style>

    <Style Selector="ColorPicker DropDownButton:pointerover /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    </Style>

    <Style Selector="ColorPicker DropDownButton:pressed /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    </Style>

    <Style Selector="ColorPicker DropDownButton:flyout-open /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</Styles>
