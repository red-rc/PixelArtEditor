<Window
    x:Class="PixelArtEditor.Windows.ExportDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:PixelArtEditor.UI"
    xmlns:controls="clr-namespace:PixelArtEditor.Controls.Image"
    xmlns:controlsGlobal="clr-namespace:PixelArtEditor.Controls"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    Width="600"
    Height="400"
    d:DesignHeight="400"
    d:DesignWidth="600"
    x:DataType="vm:ExportDialogVM"
    Background="{DynamicResource BackgroundColor}"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="sans-serif" />
        </Style>
        <Style Selector="TextBlock.Header">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="sans-serif" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="8192" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0,10,0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource SecondaryBackgroundColor}">
        <controlsGlobal:TitleBar 
            Grid.Row="0" 
            Title="Export" 
            IconVisible="False" 
            CanMinimize="False" 
            CanMaximize="False" />
        <Grid Grid.Row="1">
            <Grid
                Margin="20,30,20,0"
                ColumnDefinitions="250,Auto">
                <ui:Preview
                    Grid.Column="0"
                    IsAlreadyBgra="True"
                    Margin="30,10,0,0"
                    Layer="{Binding Layer}" />
                <StackPanel Grid.Column="1" Spacing="10">
                    <controls:PropertiesPanel DataContext="{Binding ImageProperties}" />
                </StackPanel>
            </Grid>
            <Grid
                Height="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{DynamicResource BackgroundColor}"
                ColumnDefinitions="*,Auto,Auto">
                <Button
                    Grid.Column="0"
                    Margin="0,25,10,25"
                    Padding="30,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Classes="CancelBtn"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource CrWinCancel}"
                    FontSize="20" />
                <Button
                    Grid.Column="1"
                    Margin="0,25,25,25"
                    Padding="30,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Classes="ConfirmBtn"
                    Command="{Binding ConfirmCommand}"
                    Content="{DynamicResource ExportConfirm}"
                    FontSize="20" />
            </Grid>
        </Grid>
    </Grid>
</Window>
