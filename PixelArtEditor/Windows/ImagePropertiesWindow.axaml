<Window
    x:Class="PixelArtEditor.Windows.ImagePropertiesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:PixelArtEditor.Controls.Image"
    xmlns:controlsGlobal="clr-namespace:PixelArtEditor.Controls"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    xmlns:editor="clr-namespace:PixelArtEditor.Controls.Editor"
    Width="700"
    Height="450"
    d:DesignHeight="450"
    d:DesignWidth="700"
    x:DataType="vm:ImagePropertiesVM"
    Background="{DynamicResource BackgroundColor}"
    ExtendClientAreaToDecorationsHint="True"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        </Style>
        <Style Selector="TextBlock.Header">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource SecondaryBackgroundColor}">
        <controlsGlobal:TitleBar 
            Grid.Row="0" 
            Title="Image Properties" 
            IconVisible="False" 
            CanMinimize="False" 
            CanMaximize="False" />
        <Grid RowDefinitions="*,Auto" Grid.Row="1">
            <Grid
                Grid.Row="0"
                Margin="20,30,20,0"
                ColumnDefinitions="250,Auto,10,Auto"
                DockPanel.Dock="Top">
                <editor:PreviewControl
                     Grid.Column="0"
                     Margin="0,0,0,10"
                     Width="200"
                     Height="200"
                     VerticalAlignment="Center"
                     RenderData="{Binding ImageProperties.RenderData}"
                     FixedTileSize="20" />

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Classes="Header" Text="{DynamicResource ImgPropSize}" />
                    <controls:SizePanel DataContext="{Binding ImageProperties}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="10">
                    <TextBlock Classes="Header" Text="{DynamicResource CrWinAdvanced}" />
                    <controls:PropertiesPanel DataContext="{Binding ImageProperties}" />
                </StackPanel>
            </Grid>
            <Grid
                Grid.Row="1"
                Height="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{DynamicResource BackgroundColor}"
                ColumnDefinitions="*,Auto,Auto"
                DockPanel.Dock="Bottom">
                <Button
                    Grid.Column="0"
                    Margin="0,25,10,25"
                    Padding="30,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Classes="CancelBtn"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource SetWinCancel}"
                    FontSize="20" />
                <Button
                    Grid.Column="1"
                    Margin="0,25,10,25"
                    Padding="30,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Classes="ResetBtn"
                    Command="{Binding ResetCommand}"
                    Content="{DynamicResource SetWinReset}"
                    FontSize="20" />
                <Button
                    Grid.Column="2"
                    Margin="0,25,25,25"
                    Padding="30,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Classes="ConfirmBtn"
                    Command="{Binding SaveCommand}"
                    Content="{DynamicResource SetWinSave}"
                    FontSize="20" />
            </Grid>
        </Grid>
    </Grid>
</Window>
