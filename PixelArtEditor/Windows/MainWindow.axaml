<Window
    x:Class="PixelArtEditor.Windows.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    xmlns:controls="clr-namespace:PixelArtEditor.Controls"
    Title="Pixeller"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowVM"
    Background="{DynamicResource BackgroundColor}"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    Icon="/Assets/logo.ico"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!-- Padding top=-1 fixes Avalonia Win32 1px native hit-test zone at top of window; Add if needed -->

    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <DockPanel
            Height="30"
            Background="{DynamicResource TertiaryBackgroundColor}"
            DockPanel.Dock="Top"
            KeyDown="OnKeyDown">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="30">
                    <Image
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Assets/logo.ico" />
                </Border>

                <controls:MenuBar
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <Border
                    Grid.Column="2"
                    Background="Transparent"
                    PointerMoved="OnPointerMoved"
                    PointerPressed="OnPointerPressed"
                    PointerReleased="OnPointerReleased" />
                <StackPanel
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="40"
                        Height="30"
                        Classes="WindowBaseButton"
                        Click="OnMinimizeClick">
                        <Image
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource MinimizeIcon}" />
                    </Button>
                    <Button
                        Width="40"
                        Height="30"
                        Classes="WindowBaseButton"
                        Click="OnMaximizeClick">
                        <Image
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource MaximizeIcon}" />
                    </Button>
                    <Button
                        Width="40"
                        Height="30"
                        Classes="WindowCloseButton"
                        Click="OnCloseClick">
                        <Image
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </DockPanel>
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
