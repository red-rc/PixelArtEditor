<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:PixelArtEditor.UI"
    mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
    x:Class="PixelArtEditor.Views.EditorControls.LayerPanel"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    x:DataType="vm:LayerPanelVM"
    d:Background="{DynamicResource BackgroundColor}">

    <Grid RowDefinitions="40, *, 50">
        <StackPanel Grid.Row="0" Background="{DynamicResource BackgroundColor}">
            <TextBlock Margin="10,10,10,5" Text="Layers" FontWeight="Bold" FontSize="16"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <ListBox x:Name="LayerListBox"
                     ItemsSource="{Binding LayerItems}"
                     SelectedItem="{Binding SelectedLayer}" 
                     Background="{DynamicResource BackgroundColor}"
                     SelectionMode="Multiple">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="5"/>
                    </Style>
                
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource UiHoverColor}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource UiColor}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource UiHoverColor}"/>
                    </Style>
                    
                    <Style Selector="ListBoxItem ui|InstantToggleButton.LayerItemButton /template/ ContentPresenter">
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem ui|InstantToggleButton.LayerItemButton:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource GrayColor}"/>
                    </Style>
                    
                    <Style Selector="ListBoxItem ui|InstantToggleButton.LayerItemButton:checked /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
                    </Style>
                    <Style Selector="ListBoxItem ui|InstantToggleButton.LayerItemButton:pointerover:checked /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHoverColor}"/>
                    </Style>

                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LayerItemVM">
                        <StackPanel Orientation="Horizontal">
                            <ui:Preview Margin="5" Layer="{Binding Layer}" IsAlreadyBgra="True" Size="36" Width="36" Height="36"/>
                            <TextBlock Classes="LayerItemText" Text="{Binding LayerName}" Margin="5,0,5,0"/>
                            <ui:InstantToggleButton Classes="LayerItemButton" IsChecked="{Binding IsVisible}" Margin="5,0,5,0">
                                <Image Width="12" Height="12" Source="{DynamicResource ColorPickerIcon}" />
                            </ui:InstantToggleButton>
                             <ui:InstantToggleButton Classes="LayerItemButton" IsChecked="{Binding IsLocked}" Margin="2,0,5,0">
                                <Image Width="12" Height="12" Source="{DynamicResource ColorPickerIcon}" />
                            </ui:InstantToggleButton>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="2" 
                Background="{DynamicResource BackgroundColor}" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Stretch" 
                Orientation="Horizontal">
            <Button Classes="ActionButton" Content="p" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="5" />
            <Button Classes="ActionButton" Content="m" Command="{Binding RemoveCommand}" HorizontalAlignment="Left" Margin="5" />
            <Button Classes="ActionButton" Content="d" Command="{Binding DuplicateCommand}" HorizontalAlignment="Left" Margin="5" />
            <Button Classes="ActionButton" Content="g" Command="{Binding CreateGroupCommand}" HorizontalAlignment="Left" Margin="5" />
        </StackPanel>
    </Grid>
</UserControl>
