<UserControl
    x:Class="PixelArtEditor.Views.EditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:PixelArtEditor.UI"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:EditorVM"
    Background="{DynamicResource BackgroundColor}"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="ui|InstantToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
    </UserControl.Styles>

    <Grid Name="Root" PointerMoved="Root_PointerMoved">
        <Grid
            Name="MainLayout"
            ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,*">
            <Panel
                Name="OptionsPanel"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Height="75"
                Background="{DynamicResource BackgroundColor}"
                PointerMoved="Panel_PointerMoved"
                PointerPressed="Panel_PointerPressed"
                PointerReleased="Panel_PointerReleased"
                Tag="Horizontal" />
            <Panel
                Name="LayerPanel"
                Grid.Row="1"
                Grid.Column="2"
                Width="300"
                Background="{DynamicResource BackgroundColor}"
                PointerMoved="Panel_PointerMoved"
                PointerPressed="Panel_PointerPressed"
                PointerReleased="Panel_PointerReleased"
                Tag="Vertical">
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    BorderBrush="#444444"
                    BorderThickness="0,0,0,3">

                    <Viewbox Height="350" Stretch="Fill">
                        <ColorView Color="{Binding PickedColor}" />
                    </Viewbox>
                </Border>
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Panel>
            <Panel
                Name="Toolbar"
                Grid.Row="1"
                Grid.Column="0"
                Width="40"
                Background="{DynamicResource BackgroundColor}"
                PointerMoved="Panel_PointerMoved"
                PointerPressed="Panel_PointerPressed"
                PointerReleased="Panel_PointerReleased"
                Tag="Vertical">
                <StackPanel x:Name="ToolbarStackPanel">
                    <ui:InstantToggleButton
                        HorizontalAlignment="Center"
                        Classes="ToolButton"
                        IsChecked="{Binding IsPenEnabled}"
                        Tag="Pen">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource PenIcon}" />
                    </ui:InstantToggleButton>
                    <ui:InstantToggleButton
                        HorizontalAlignment="Center"
                        Classes="ToolButton"
                        IsChecked="{Binding IsColorPickerEnabled}"
                        Tag="ColorPicker">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource ColorPickerIcon}" />
                    </ui:InstantToggleButton>
                    <ui:InstantToggleButton
                        HorizontalAlignment="Center"
                        Classes="ToolButton"
                        IsChecked="{Binding IsFillEnabled}"
                        Tag="Fill">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource FillIcon}" />
                    </ui:InstantToggleButton>
                    <ui:InstantToggleButton
                        HorizontalAlignment="Center"
                        Classes="ToolButton"
                        IsChecked="{Binding IsEraserEnabled}"
                        Tag="Eraser">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource EraserIcon}" />
                    </ui:InstantToggleButton>
                    <ui:InstantToggleButton
                        HorizontalAlignment="Center"
                        Classes="ToolButton"
                        IsChecked="{Binding IsHandEnabled}"
                        Tag="Hand">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource HandIcon}" />
                    </ui:InstantToggleButton>
                </StackPanel>
            </Panel>
            <Panel
                Name="CanvasPanel"
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource SecondaryBackgroundColor}"
                ClipToBounds="True"
                PointerMoved="CanvasPanel_OnPointerMoved"
                PointerPressed="CanvasPanel_OnPointerPressed"
                PointerReleased="CanvasPanel_OnPointerReleased"
                PointerWheelChanged="CanvasPanel_OnPointerWheelChanged"
                SizeChanged="CanvasPanel_OnSizeChanged"
                Tag="Vertical">
                <ui:Canvas
                    x:Name="CanvasControl"
                    PickedColor="{Binding PickedColor, Mode=TwoWay}"
                    Scale="{Binding Scale}"
                    SelectedTool="{Binding SelectedTool}"
                    Offset="{Binding Offset}" />
                <TextBlock
                    Height="15"
                    Padding="5,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#BF4A4A4A"
                    FontSize="12"
                    Foreground="White"
                    Text="{Binding IndicatorText}" />
            </Panel>
        </Grid>
        <Canvas x:Name="FloatingHost" IsHitTestVisible="True" />
        <Canvas x:Name="RectHost" />
        <Canvas Name="TooltipHost">
            <Border
                x:Name="Tooltip"
                Padding="5"
                Background="{DynamicResource UiColor}"
                CornerRadius="5"
                IsVisible="false">
                <TextBlock
                    x:Name="TooltipText"
                    FontSize="14"
                    Foreground="{DynamicResource ForegroundColor}" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>