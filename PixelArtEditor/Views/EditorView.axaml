<UserControl
    x:Class="PixelArtEditor.Views.EditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:PixelArtEditor.Views.EditorControls"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    d:DesignHeight="720"
    d:DesignWidth="1380"
    x:DataType="vm:EditorVM"
    Background="{DynamicResource BackgroundColor}"
    mc:Ignorable="d">

    <Grid Name="Root" Focusable="True" PointerMoved="Root_PointerMoved">
        <Grid
            Name="MainLayout"
            ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,*">
            <Panel
                Name="OptionsPanel"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Height="75"
                Background="{DynamicResource BackgroundColor}"
                PointerMoved="Panel_PointerMoved"
                PointerPressed="Panel_PointerPressed"
                PointerReleased="Panel_PointerReleased"
                Tag="Horizontal" />
            <Grid
                Name="SidePanel"
                Grid.Row="1"
                Grid.Column="2"
                RowDefinitions="Auto,*"
                Width="300"
                Background="{DynamicResource BackgroundColor}"
                PointerMoved="Panel_PointerMoved"
                PointerPressed="Panel_PointerPressed"
                PointerReleased="Panel_PointerReleased"
                Tag="Vertical">
                <Border
                    Grid.Row="0"
                    Classes="EditorBorder"
                    BorderThickness="0,0,0,3">

                    <Viewbox Height="350" Stretch="Fill">
                        <ColorView Color="{Binding PickedColor}" />
                    </Viewbox>
                </Border>

                <controls:LayerPanel 
                    x:Name="LayerPanelControl"
                    Grid.Row="1" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" />
            </Grid>

            <controls:Toolbar
                Name="ToolbarPanel"
                Grid.Row="1"
                Grid.Column="0"
                PointerMoved="Panel_PointerMoved"
                PointerPressed="Panel_PointerPressed"
                PointerReleased="Panel_PointerReleased"
                Tag="Vertical" />
            <Panel
                Name="CanvasPanel"
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource SecondaryBackgroundColor}"
                ClipToBounds="True"
                PointerMoved="CanvasPanel_OnPointerMoved"
                PointerPressed="CanvasPanel_OnPointerPressed"
                PointerReleased="CanvasPanel_OnPointerReleased"
                PointerWheelChanged="CanvasPanel_OnPointerWheelChanged"
                SizeChanged="CanvasPanel_OnSizeChanged"
                Tag="Vertical">
                <controls:Canvas
                    x:Name="CanvasControl"
                    Model="{Binding Model}"
                    PickedColor="{Binding PickedColor, Mode=TwoWay}"
                    Scale="{Binding Scale}"
                    SelectedTool="{Binding SelectedTool}"
                    Offset="{Binding Offset}" />
                <TextBlock
                    Height="15"
                    Padding="5,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#BF4A4A4A"
                    FontSize="12"
                    Foreground="White"
                    Text="{Binding IndicatorText}" />
            </Panel>
        </Grid>
        <Canvas x:Name="FloatingHost" IsHitTestVisible="True" />
        <Canvas x:Name="RectHost" />
        <Canvas Name="TooltipHost">
            <Border
                x:Name="Tooltip"
                Padding="5"
                Background="{DynamicResource UiColor}"
                CornerRadius="5"
                IsVisible="false">
                <TextBlock
                    x:Name="TooltipText"
                    FontSize="14"
                    Foreground="{DynamicResource ForegroundColor}" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>