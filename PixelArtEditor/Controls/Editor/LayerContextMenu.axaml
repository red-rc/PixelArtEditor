<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:PixelArtEditor.Controls.Editor"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PixelArtEditor.Controls.Editor.LayerContextMenu"
             x:DataType="local:LayerContextMenu">

    <UserControl.Styles>
        <Style Selector="Border.InnerBorder">
            <Setter Property="Background" Value="{DynamicResource UiColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style Selector="MenuItem.DeleteItem">
            <Setter Property="Foreground" Value="#f5554a" />
        </Style>
    </UserControl.Styles>
    <Border Padding="6">
        <Border Classes="InnerBorder">
            <StackPanel Orientation="Vertical">
                <MenuItem Header="Rename" Click="RenameClick" />
                <MenuItem Header="Duplicate" Click="DuplicateClick" />
                <MenuItem Header="Create Group" Click="GroupClick" />
                <MenuItem Header="Merge Layers" Click="MergeClick" />
                <MenuItem Header="Transform" Click="TransformClick" />
                <Separator />
                <MenuItem Header="Export" Click="ExportClick" />
                <MenuItem Header="Filters &amp; Correction" Click="FiltersClick" />
                <Separator />
                <MenuItem Classes="DeleteItem" Header="Delete" Click="DeleteClick" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
