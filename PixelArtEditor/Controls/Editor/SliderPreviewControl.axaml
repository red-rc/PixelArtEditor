<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editor="clr-namespace:PixelArtEditor.Controls.Editor"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PixelArtEditor.Controls.Editor.SliderPreviewControl"
             x:Name="Root"
             ClipToBounds="False">

    <Grid RowDefinitions="*,200">
        <Slider
            Grid.Row="0"
            Minimum="0"
            Maximum="1"
            Value="{Binding CheckerboardOpacity, ElementName=Root, Mode=TwoWay}"
            Width="200"
            HorizontalAlignment="Center" />
        <Grid Grid.Row="1">
            <Border 
                Background="#222222"
                Width="200"
                Height="200" />
             <editor:PreviewControl
                Width="200"
                Height="200"
                RenderData="{Binding RenderData, ElementName=Root}"
                FixedTileSize="20"
                CheckerboardOpacity="{Binding CheckerboardOpacity, ElementName=Root}" />
        </Grid>
    </Grid>
</UserControl>