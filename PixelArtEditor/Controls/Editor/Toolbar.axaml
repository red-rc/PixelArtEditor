<UserControl     
    x:Class="PixelArtEditor.Controls.Editor.Toolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:PixelArtEditor.UI"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="40"
    x:DataType="vm:EditorVM"
    Background="{DynamicResource BackgroundColor}"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="ui|InstantToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
    </UserControl.Styles>

    <Panel
        Width="40"
        Background="{DynamicResource BackgroundColor}">
        <StackPanel x:Name="StackPanel">
            <ui:InstantToggleButton
                HorizontalAlignment="Center"
                Classes="ToolBtn"
                IsChecked="{Binding Tools.IsPenEnabled}"
                Tag="Pen">
                <Image
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{DynamicResource PenIcon}" />
            </ui:InstantToggleButton>
            <ui:InstantToggleButton
                HorizontalAlignment="Center"
                Classes="ToolBtn"
                IsChecked="{Binding Tools.IsColorPickerEnabled}"
                Tag="ColorPicker">
                <Image
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{DynamicResource ColorPickerIcon}" />
            </ui:InstantToggleButton>
            <ui:InstantToggleButton
                HorizontalAlignment="Center"
                Classes="ToolBtn"
                IsChecked="{Binding Tools.IsFillEnabled}"
                Tag="Fill">
                <Image
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{DynamicResource FillIcon}" />
            </ui:InstantToggleButton>
            <ui:InstantToggleButton
                HorizontalAlignment="Center"
                Classes="ToolBtn"
                IsChecked="{Binding Tools.IsEraserEnabled}"
                Tag="Eraser">
                <Image
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{DynamicResource EraserIcon}" />
            </ui:InstantToggleButton>
            <ui:InstantToggleButton
                HorizontalAlignment="Center"
                Classes="ToolBtn"
                IsChecked="{Binding Tools.IsHandEnabled}"
                Tag="Hand">
                <Image
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{DynamicResource HandIcon}" />
            </ui:InstantToggleButton>
        </StackPanel>
    </Panel>
</UserControl>
