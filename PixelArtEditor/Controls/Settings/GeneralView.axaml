<UserControl
    x:Class="PixelArtEditor.Controls.Settings.GeneralView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PixelArtEditor.ViewModels"
    d:DesignHeight="350"
    d:DesignWidth="450"
    x:DataType="vm:SettingsDialogVM"
    Background="{DynamicResource SecondaryBackgroundColor}"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.Heading">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="8192" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0,10,0" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Vertical" Spacing="15">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="Label" Text="{DynamicResource Language}" />
            <ComboBox
                Width="200"
                ItemsSource="{Binding LanguagePairs}"
                SelectedItem="{Binding Language, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Value}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel> 
        <StackPanel Spacing="5">
            <TextBlock
                Margin="0,10,0,0"
                Classes="Heading"
                Text="{DynamicResource Autosave}" />
            <Separator
                Height="1"
                Margin="0.5"
                Background="Gray"
                Foreground="{DynamicResource ForegroundColor}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="Label" Text="{DynamicResource EnableAutosave}" />
                <CheckBox IsChecked="{Binding EnableAutosave}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="Label" Text="{DynamicResource AutosaveEvery}" />
                <NumericUpDown
                    Width="50"
                    IsEnabled="{Binding EnableAutosave}"
                    Maximum="900"
                    Minimum="10"
                    Value="{Binding AutosaveFrequency, FallbackValue=10}" />
                <TextBlock Classes="Label" Text="{DynamicResource Seconds}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
