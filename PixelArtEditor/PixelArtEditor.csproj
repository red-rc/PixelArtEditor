<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\Overrides\ColorViewOverride.axaml" />
    <AvaloniaResource Include="Styles\Overrides\ColorPickerOverride.axaml" />
    <AvaloniaResource Include="Styles\Overrides\MenuItemOverride.axaml" />
    <AvaloniaResource Include="Styles\Overrides\MenuOverride.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="HeyRed.ImageSharp.Heif" />
    <PackageReference Include="MessageBox.Avalonia" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Localization\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\Image\PropertiesPanel.axaml.cs">
      <DependentUpon>PropertiesPanel.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\Image\SizePanel.axaml.cs">
      <DependentUpon>SizePanel.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\MenuBar.axaml.cs">
      <DependentUpon>MenuBar.axaml</DependentUpon>
    </Compile>
    <Compile Update="Windows\ImagePropertiesWindow.axaml.cs">
      <DependentUpon>ImagePropertiesWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
