<Application
    x:Class="PixelArtEditor.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixelArtEditor"
    xmlns:viewModels="clr-namespace:PixelArtEditor.ViewModels"
    xmlns:controls="clr-namespace:PixelArtEditor.Controls.Views">
    <!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->

    <Application.DataTemplates>
        <local:ViewLocator />
        <DataTemplate DataType="{x:Type viewModels:StartMenuVM}">
            <controls:StartMenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:EditorVM}">
            <controls:EditorView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{DynamicResource UiColor}" />
        <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="{DynamicResource ShadowColor}" />
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml" />
        <StyleInclude Source="avares://PixelArtEditor/Styles/ColorViewOverride.axaml" />
        <StyleInclude Source="avares://PixelArtEditor/Styles/ColorPickerOverride.axaml" />
    </Application.Styles>
</Application>